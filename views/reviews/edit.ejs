<% layout("/layouts/boilerplate") %>

<div class="row mt-4">
  <div class="col-12 col-md-8 col-lg-6 offset-md-2 offset-lg-3">
    <h3>Edit your review</h3>
    <form action="/listings/<%= listingId %>/reviews/<%= review._id %>?_method=PUT" method="POST" novalidate class="needs-validation">
      <div class="mb-3 mt-3">
        <label class="form-label">Rating</label>
        <fieldset class="starability-heartbeat">
          <% for (let i = 1; i <= 5; i++) { %>
            <input type="radio" id="edit-rate<%= i %>" name="review[rating]" value="<%= i %>" <%= review.rating === i ? "checked" : "" %> />
            <label for="edit-rate<%= i %>" title="<%= i %> star"><%= i %> star</label>
          <% } %>
        </fieldset>
      </div>
      <div class="mb-3">
        <label for="comment" class="form-label">Comments</label>
        <textarea name="review[comment]" id="comment" rows="5" class="form-control" required><%= review.comment %></textarea>
        <div class="invalid-feedback">Please add some content for the review</div>
      </div>
      <button class="btn btn-dark">Update</button>
      <a href="/listings/<%= listingId %>" class="btn btn-outline-secondary ms-2">Cancel</a>
    </form>
  </div>
</div>
