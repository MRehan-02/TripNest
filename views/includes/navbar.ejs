<nav class="navbar navbar-expand-md sticky-top">
  <div class="container">
    <!-- Brand Logo -->
    <a class="navbar-brand d-flex align-items-center gap-2" href="/listings">
      <i class="fa-regular fa-compass brand-icon"></i>
      <span class="brand-title">TripNest</span>
    </a>

    <!-- Mobile Toggler -->
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNav">
      <!-- Enhanced Pill Search Bar -->
      <form class="d-flex mx-auto search-bar my-2 my-md-0" action="/listings" method="GET">
        <input class="form-control search-input" type="search" name="q" placeholder="Search destinations, stays..." aria-label="Search">
        <button class="btn btn-search" type="submit">
          <i class="fa-solid fa-magnifying-glass"></i>
        </button>
      </form>

      <!-- Right Navigation Links -->
      <div class="navbar-nav ms-auto align-items-center gap-2">
        <button type="button" class="btn btn-sm theme-toggle" id="themeToggle" onclick="toggleTheme()" aria-label="Toggle dark mode">
          <i class="fa-solid fa-moon"></i>
        </button>
        <% if(currUser && currUser.role === "owner") { %>
          <a class="nav-link host-link" href="/listings/new">TripNest your home</a>
        <% } %>
        <% if(!currUser) { %>
          <a class="nav-link host-link" href="/signup?role=owner">Become an owner</a>
          <a class="nav-link fw-bold" href="/signup">Sign up</a>
          <a class="nav-link fw-bold" href="/login">Log in</a>
        <% } %>

        <% if(currUser) { %>
          <div class="nav-item dropdown">
            <a class="nav-link user-profile-btn dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
              <i class="fa-solid fa-bars me-2 text-secondary"></i>
              <span class="user-avatar"><%= currUser.username.charAt(0).toUpperCase() %></span>
            </a>
            <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-4 mt-2 py-2">
              <li class="dropdown-header">Signed in as <b>@<%= currUser.username %></b> (<%= currUser.role %>)</li>
              <li><a class="dropdown-item py-2" href="/listings">Explore Stays</a></li>
              <% if(currUser.role === "owner") { %>
                <li><a class="dropdown-item py-2" href="/listings/new">Add new Listing</a></li>
                <li><a class="dropdown-item py-2" href="/listings/mine">My Listings</a></li>
                <li><a class="dropdown-item py-2" href="/dashboard">Dashboard</a></li>
              <% } else { %>
                <li><a class="dropdown-item py-2" href="/bookings">My Bookings</a></li>
                <li><a class="dropdown-item py-2" href="/wishlist">My Wishlist</a></li>
              <% } %>
              <li><hr class="dropdown-divider"></li>
              <li>
                <form action="/logout" method="POST" class="m-0">
                  <button class="dropdown-item py-2 text-danger fw-semibold">Log out</button>
                </form>
              </li>
            </ul>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</nav>