<% layout("/layouts/boilerplate") %>
<%
  const badge = { Pending: "warning text-dark", Confirmed: "success", Cancelled: "secondary" };
  const fmt = (d) => new Date(d).toLocaleDateString("en-IN", { day: "2-digit", month: "short", year: "numeric", timeZone: "UTC" });
%>

<div class="d-flex flex-wrap justify-content-between align-items-center mt-3 mb-3 gap-2">
  <h3 class="fw-bold mb-0">Owner Dashboard</h3>
  <div class="d-flex gap-2">
    <a href="/listings/new" class="btn btn-rose rounded-3">Add new listing</a>
    <a href="/listings/mine" class="btn btn-outline-secondary rounded-3">My listings</a>
  </div>
</div>

<!-- Stat cards -->
<div class="row g-3 mb-4">
  <div class="col-6 col-lg-3">
    <div class="card border-0 shadow-sm rounded-4 p-3 text-center">
      <div class="text-muted small">Total listings</div>
      <div class="fs-2 fw-bold"><%= stats.totalListings %></div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card border-0 shadow-sm rounded-4 p-3 text-center">
      <div class="text-muted small">Total bookings</div>
      <div class="fs-2 fw-bold"><%= stats.totalBookings %></div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card border-0 shadow-sm rounded-4 p-3 text-center">
      <div class="text-muted small">Pending / Confirmed</div>
      <div class="fs-2 fw-bold"><%= stats.pending %> / <%= stats.confirmed %></div>
    </div>
  </div>
  <div class="col-6 col-lg-3">
    <div class="card border-0 shadow-sm rounded-4 p-3 text-center">
      <div class="text-muted small">Earnings (confirmed)</div>
      <div class="fs-2 fw-bold">&#8377; <%= stats.earnings.toLocaleString("en-IN") %></div>
    </div>
  </div>
</div>

<h5 class="fw-bold mb-3">Bookings on my listings</h5>

<% if(bookings.length === 0){ %>
  <div class="text-center py-4">
    <i class="fa-regular fa-calendar fa-3x text-muted mb-3"></i>
    <h5 class="fw-bold">No bookings yet</h5>
    <p class="text-muted">When a user books one of your stays, it will show up here.</p>
  </div>
<% } else { %>
  <div class="table-responsive">
    <table class="table align-middle">
      <thead>
        <tr>
          <th>Listing</th>
          <th>Guest</th>
          <th>Dates</th>
          <th>Guests</th>
          <th>Total</th>
          <th>Status</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% for(let b of bookings){ %>
          <tr>
            <td><%= b.listing ? b.listing.title : "Removed" %></td>
            <td>@<%= b.user ? b.user.username : "deleted" %></td>
            <td class="text-nowrap"><%= fmt(b.checkIn) %> &rarr; <%= fmt(b.checkOut) %></td>
            <td><%= b.guests %></td>
            <td class="text-nowrap">&#8377; <%= (b.total || 0).toLocaleString("en-IN") %></td>
            <td><span class="badge bg-<%= badge[b.status] %>"><%= b.status %></span></td>
            <td class="text-nowrap">
              <% if(b.status === "Pending"){ %>
                <form method="POST" action="/bookings/<%= b._id %>/status?_method=PUT" class="d-inline">
                  <input type="hidden" name="status" value="Confirmed">
                  <button class="btn btn-sm btn-success">Confirm</button>
                </form>
                <form method="POST" action="/bookings/<%= b._id %>/status?_method=PUT" class="d-inline"
                      onsubmit="return confirm('Reject this booking?');">
                  <input type="hidden" name="status" value="Cancelled">
                  <button class="btn btn-sm btn-outline-danger">Reject</button>
                </form>
              <% } else if(b.status === "Confirmed"){ %>
                <form method="POST" action="/bookings/<%= b._id %>/status?_method=PUT" class="d-inline"
                      onsubmit="return confirm('Cancel this confirmed booking?');">
                  <input type="hidden" name="status" value="Cancelled">
                  <button class="btn btn-sm btn-outline-danger">Cancel</button>
                </form>
              <% } else { %>
                <span class="text-muted small">&mdash;</span>
              <% } %>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
<% } %>
